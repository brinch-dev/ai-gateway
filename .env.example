# Anthropic credentials (or use `ant auth login` locally)
ANTHROPIC_API_KEY=

# Comma-separated client keys in the form clientId:secret
# Generate secrets with: openssl rand -hex 32
GATEWAY_API_KEYS=erp:change-me,crm:change-me-too

PORT=8080
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500
MAX_INPUT_CHARS=50000
